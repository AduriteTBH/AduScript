{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AduScript",
  "scopeName": "source.ads",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#reactivity" },
    { "include": "#pipeline" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.triple-slash.ads", "match": "///.*$" },
        { "name": "comment.line.double-slash.ads", "match": "//.*$" },
        { "name": "comment.block.ads", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.declaration.immutable.ads", "match": "\\blet\\b" },
        { "name": "keyword.control.declaration.mutable.ads", "match": "\\bmut\\b" },
        { "name": "keyword.control.module.use.ads", "match": "\\buse\\b" },
        { "name": "keyword.control.module.import.ads", "match": "\\b(import|export|from|as)\\b" },
        { "name": "keyword.control.flow.match.ads", "match": "\\b(match|with)\\b" },
        { "name": "keyword.control.flow.ads", "match": "\\b(if|else|for|in|while|return|try|catch|finally|throw|break|continue|default)\\b" },
        { "name": "keyword.operator.new.ads", "match": "\\b(new|typeof|instanceof)\\b" },
        { "name": "keyword.control.async.ads", "match": "\\b(async|await)\\b" }
      ]
    },
    "reactivity": {
      "patterns": [
        { "name": "keyword.other.reactivity.state.ads", "match": "\\bstate\\b" },
        { "name": "keyword.other.reactivity.watch.ads", "match": "\\bwatch\\b" },
        { "name": "keyword.other.reactivity.effect.ads", "match": "\\beffect\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "storage.type.function.ads", "match": "\\bfn\\b" },
        {
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.ads" }
          }
        }
      ]
    },
    "pipeline": {
      "patterns": [
        { "name": "keyword.operator.pipeline.ads", "match": "\\|>" },
        { "name": "variable.language.placeholder.ads", "match": "\\b_\\b" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.formatted.ads",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ads", "match": "\\\\." },
            {
              "name": "meta.embedded.interpolation.ads",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.template.ads",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.ads", "match": "\\\\." },
            {
              "name": "meta.embedded.interpolation.ads",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.double.ads",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.ads", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.ads",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.ads", "match": "\\\\." }]
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.ads", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.ads", "match": "\\b(null|undefined)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.ads", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.binary.ads", "match": "\\b0[bB][01]+\\b" },
        { "name": "constant.numeric.decimal.ads", "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.ads", "match": "->|=>" },
        { "name": "keyword.operator.range.ads", "match": "\\.\\." },
        { "name": "keyword.operator.logical.ads", "match": "&&|\\|\\||!|\\?\\?" },
        { "name": "keyword.operator.comparison.ads", "match": "===|!==|==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.ads", "match": "=|\\+=|-=|\\*=|/=|%=" }
      ]
    }
  }
}
